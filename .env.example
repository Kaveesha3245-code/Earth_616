# Local server settings. Copy to .env and launch with:
# node --env-file=.env server/start.mjs
# Or set these variables in the process/hosting environment.
# Never commit your populated .env file or put it in public/ or dist/.

HOST=127.0.0.1
PORT=4173
NODE_ENV=development

# Empty preserves the source project's local birthday gate default.
# Set a unique value before exposing the server.
PORTAL_PASSWORD=

# Empty uses the gate password for the local prototype.
# Use a different strong credential for moderator access on a deployment.
PORTAL_ADMIN_PASSWORD=

# At least 32 characters when supplied. Empty creates a random signing key
# stored privately in PORTAL_DATA_DIR/session-key and reused across restarts.
PORTAL_SESSION_SECRET=

# Optional absolute persistent private directory. Empty uses project/.data.
# This directory must not be publicly served or included in the static build.
PORTAL_DATA_DIR=

# Exact public browser origin for a reverse proxy, e.g. https://birthday.example.
# Empty requires the browser Origin hostname and port to match the request Host.
PORTAL_ORIGIN=

# Optional scanner executable and fixed arguments. {file} is the file placeholder;
# the server invokes the executable directly without a shell.
# Default attempts: clamscan --no-summary
# CLAMAV_SCAN_COMMAND=clamscan --no-summary {file}

# Development can retain an unscanned submission for private local review.
# NODE_ENV=production rejects uploads if the malware scanner is unavailable.

# Optional build-time adaptive media configuration. Supplied MP4 files work
# without these. Never put credentials in a VITE_ variable (they are public).
# VITE_INTRO_HLS_URL=/media/hls/intro/master.m3u8
# VITE_INTRO_PORTRAIT_HLS_URL=/media/hls/intro-portrait/master.m3u8
# VITE_HLS_MODULE_URL=/vendor/hls.mjs
